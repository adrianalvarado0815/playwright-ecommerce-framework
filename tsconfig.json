{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    /* 
      This line tells TypeScript to recognize global Node.js 
      variables like 'process' and '__dirname' everywhere
    */
    "types": ["node"]
  },
  "include": ["tests/**/*", "pages/**/*", "playwright.config.ts"]
}